PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/kartik_portfolio
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# Set 1 only behind a single trusted reverse proxy (e.g. configured Render service).
TRUST_PROXY=0
# Optional email notifications. Configure with your SMTP provider; never commit credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_NOTIFY_TO=
